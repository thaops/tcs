{
  // ===== Flutter / Dart Performance =====
  "dart.analysisServer.clientMemoryMax": 4096,
  "dart.debugExternalPackageLibraries": false,
  "dart.debugSdkLibraries": false,
  "dart.showTodos": false,
  "dart.warnWhenEditingFilesOutsideWorkspace": false,

  // Tắt bớt validation JavaScript/TypeScript để VSCode nhẹ hơn
  "javascript.validate.enable": false,
  "typescript.validate.enable": false,

  // ===== Editor =====
  "editor.formatOnSave": true,
  "editor.inlineSuggest.enabled": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "editor.fontSize": 14,
  "editor.minimap.enabled": false,
  "editor.smoothScrolling": true,

  // ===== Explorer: Ẩn files / folders nặng không cần thiết =====
  "files.exclude": {
    "**/.git": true,
    "**/.dart_tool": true,
    "**/build": true,
    "**/ios/Pods": true,
    "**/android/.gradle": true,
    "**/.DS_Store": true
  },

  // ===== Search: chỉ search file quan trọng =====
  "search.exclude": {
    "**/build": true,
    "**/.dart_tool": true,
    "**/node_modules": true,
    "**/ios/Pods": true,
    "**/android/build": true,
    "**/android/.gradle": true,
    "**/web/**": false,
    "**/assets/**": false
  },

  // ===== File watcher: giảm CPU khi VSCode chạy nền =====
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/build/**": true,
    "**/.dart_tool/**": true,
    "**/node_modules/**": true,
    "**/ios/Pods/**": true
  },

  // ===== Terminal =====
  "terminal.integrated.defaultProfile.windows": "Command Prompt",
  "terminal.integrated.enablePersistentSessions": false,

  // ===== Git =====
  "git.autorefresh": false,
  "git.enableSmartCommit": true,
  "git.confirmSync": false,

  // ===== Flutter Specific ======
  "flutter.hotReloadOnSave": true,

  // ===== UI nhẹ hơn =====
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "none",
  "workbench.editor.enablePreview": true,

  // ===== File Associations =====
  "files.associations": {
    "*.dart": "dart",
    "*.arb": "json",
    "*.yaml": "yaml"
  }
}
